# Bounty Hunter Configuration (.env)
# Copy this file to .env or run: bb h1 configure

# HackerOne API Authentication
# API tokens can be generated from: https://hackerone.com/settings/api_token
H1_USERNAME=your_hackerone_username
H1_TOKEN=your_hackerone_api_token

# Optional: Local storage directory (defaults to ./data)
# BB_DATA=./data

# Optional: LLM Endpoint (Ollama)
# OLLAMA_URL=http://127.0.0.1:11434
# BB_MODEL=freehuntx/qwen3-coder:8b
